# --- Sarvam AI -------------------------------------------------------------
# Without a key the app runs with the offline rule-based planner and the voice
# interface is disabled. Nothing else breaks.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- ISRO Bhuvan (NRSC) ----------------------------------------------------
# Bhuvan issues ONE TOKEN PER THEME, and each expires after a day.
#   1. Register: https://bhuvan-cas1.nrsc.gov.in/new_cas_files/WebClientProfile.php
#   2. Log in:   https://bhuvan-app1.nrsc.gov.in/api/
#   3. Use "Get Access Token", picking one theme at a time, and copy the token.
#
# Which theme feeds which capability:
#   Village Geocoding + Village Reverse Geocoding -> BHUVAN_TOKEN_GEOCODING
#   LULC AOI Wise                                 -> BHUVAN_TOKEN_LULC
#   Postal and Hospital                           -> BHUVAN_TOKEN_PROXIMITY
#   Routing                                       -> BHUVAN_TOKEN_ROUTING
#
# Any theme you leave unset falls back to BHUVAN_TOKEN. A capability with no
# token at all falls back to bundled sample data, and the app reports itself
# as "mixed" rather than pretending everything is live.
BHUVAN_TOKEN=
BHUVAN_TOKEN_GEOCODING=
BHUVAN_TOKEN_LULC=
BHUVAN_TOKEN_PROXIMITY=
BHUVAN_TOKEN_ROUTING=
BHUVAN_LULC_SCALE=250k

# auto (default) = use live services when credentials exist, else fixtures
# live           = force live services
# fixture        = force bundled sample data
BHOOMI_DATA_MODE=auto

# Bhuvan LULC WMS (the map overlay). Defaults to the 1:250,000 service.
BHUVAN_WMS_URL=https://bhuvan-ras2.nrsc.gov.in/cgi-bin/LULC250K.exe

# Satellite basemap tile template. {z}/{y}/{x} are filled by the map library.
BHOOMI_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

BHOOMI_DEFAULT_LANGUAGE=en-IN
BHOOMI_DEFAULT_RADIUS_M=5000
BHOOMI_MAX_AGENT_STEPS=5
BHOOMI_HTTP_TIMEOUT_S=20
BHOOMI_HTTP_RETRIES=2
