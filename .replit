# Replit entry point. Import this repository with "Import from GitHub" and this
# file does the rest: Python 3.12, dependencies installed, served on port 8000.
run = "bash run.sh"
entrypoint = "main.py"
modules = ["python-3.12"]

[nix]
channel = "stable-24_05"

[env]
BHOOMI_DATA_MODE = "auto"
BHOOMI_DEFAULT_LANGUAGE = "en-IN"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "run.sh"]

[gitHubImport]
requiredFiles = [".replit", "run.sh", "requirements.txt", "main.py"]
